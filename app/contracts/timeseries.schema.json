  "$defs": {
    "TimeseriesRequest": {
      "properties": {
        "dataset_id": {
          "description": "Dataset ID",
          "pattern": "^[\\w-]+$",
          "title": "Dataset Id",
          "type": "string"
        },
        "max_processing_time": {
          "default": 20000,
          "maximum": 20000,
          "minimum": 0,
          "title": "Max Processing Time",
          "type": "integer"
        },
        "requested_series_options": {
          "items": {
            "$ref": "#/$defs/SeriesOptions"
          },
          "maxItems": 10,
          "minItems": 1,
          "title": "Requested Series Options",
          "type": "array"
        },
        "selected_area": {
          "anyOf": [
            {
              "$ref": "#/$defs/SkopePointModel"
            },
            {
              "$ref": "#/$defs/SkopePolygonModel"
            },
            {
              "$ref": "#/$defs/SkopeFeatureModel"
            },
            {
              "$ref": "#/$defs/SkopeFeatureCollectionModel"
            }
          ],
          "title": "Selected Area"
        },
        "time_range": {
          "anyOf": [
            {
              "$ref": "#/$defs/TimeRange"
            },
            {
              "type": "null"
            }
          ]
        },
        "transform": {
          "discriminator": {
            "mapping": {
              "NoTransform": "#/$defs/NoTransform",
              "ZScoreFixedInterval": "#/$defs/ZScoreFixedInterval",
              "ZScoreMovingInterval": "#/$defs/ZScoreMovingInterval"
            },
            "propertyName": "type"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/ZScoreMovingInterval"
            },
            {
              "$ref": "#/$defs/ZScoreFixedInterval"
            },
            {
              "$ref": "#/$defs/NoTransform"
            }
          ],
          "title": "Transform"
        },
        "variable_id": {
          "description": "Variable ID",
          "pattern": "^[\\w-]+$",
          "title": "Variable Id",
          "type": "string"
        },
        "zonal_statistic": {
          "$ref": "#/$defs/ZonalStatistic"
        }
      },
      "required": [
        "requested_series_options",
        "dataset_id",
        "variable_id",
        "selected_area",
        "zonal_statistic",
        "transform",
        "time_range"
      ],
      "title": "TimeseriesRequest",
      "type": "object"
    },
    "SeriesOptions": {
      "example": {
        "name": "transformed",
        "smoother": {
          "method": "centered",
          "type": "MovingAverageSmoother",
          "width": 3
